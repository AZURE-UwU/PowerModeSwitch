<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PowerModeSwitch.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="联想电源模式助手">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="RootGrid"
            Padding="24"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="26"
                    FontWeight="SemiBold"
                    Text="电源模式助手" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="仅在适配器接入或断开时切换一次联想性能模式" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button
                    Click="TestToastButton_Click"
                    Content="测试通知" />
                <Button
                    x:Name="RefreshButton"
                    Click="RefreshButton_Click"
                    Content="刷新状态" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Padding="18"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="7">
                    <TextBlock
                        x:Name="AdapterStatusText"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="正在读取电源状态…" />
                    <TextBlock
                        x:Name="CurrentModeText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="正在读取联想模式…" />
                </StackPanel>

                <ToggleSwitch
                    x:Name="AutomationToggle"
                    Grid.Column="1"
                    Header="自动切换"
                    OffContent="已暂停"
                    OnContent="已启用"
                    Toggled="AutomationToggle_Toggled"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Padding="18"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel Spacing="14">
                <TextBlock
                    FontSize="17"
                    FontWeight="SemiBold"
                    Text="自动规则" />
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="接入适配器" />
                    <FontIcon
                        Grid.Column="1"
                        FontSize="13"
                        Glyph="&#xE72A;" />
                    <TextBlock
                        Grid.Column="2"
                        Text="平衡模式（LITSSVC 135）" />
                </Grid>
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="断开适配器" />
                    <FontIcon
                        Grid.Column="1"
                        FontSize="13"
                        Glyph="&#xE72A;" />
                    <TextBlock
                        Grid.Column="2"
                        Text="省电模式（LITSSVC 146）" />
                </Grid>
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="稳定识别后" />
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="10">
                        <NumberBox
                            x:Name="BatteryDelayNumberBox"
                            Width="118"
                            Minimum="0"
                            Maximum="3600"
                            SmallChange="1"
                            LargeChange="10"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="BatteryDelayNumberBox_ValueChanged" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="秒后切换" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border
            Grid.Row="3"
            Padding="18"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel Spacing="10">
                <TextBlock
                    FontSize="17"
                    FontWeight="SemiBold"
                    Text="运行说明" />
                <TextBlock
                    x:Name="DetailText"
                    Text="正在启动…"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="延时范围 0–3600 秒，0 表示立即切换；设置会保存。程序启动时不会覆盖当前模式，用户随时可按 Fn+Q 自行切换，程序不会持续纠正。"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="LastTransitionText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="1"
                Click="HideButton_Click"
                Content="隐藏到托盘" />
        </Grid>
        </Grid>
    </ScrollViewer>
</Window>
